# Database configuration
MYSQL_ROOT_PASSWORD=rootpassword        # Change this to your local root password if needed
MYSQL_DATABASE=tadreeb_sis             # Keep this the same for all team members
MYSQL_USER=tadreeb_user                # Keep this the same
MYSQL_PASSWORD=userpassword            # Optional: can change locally, but you should update your .env accordingly

# PHP backend settings
DB_HOST=localhost                      # Keep this the same
DB_NAME=tadreeb_sis                    # Keep this the same
DB_USER=tadreeb_user                    # Keep this the same
DB_PASS=userpassword                    # Optional: must match the MYSQL_PASSWORD in this environment
